{
    "manifest_version": 3,
    "default_locale": "en",
    "name": "BiliStreamMonitor",
    "version": "4.0",
    "description": "Monitor Bilibili live status for your medal wall, custom rooms and marked streamers.",
    "minimum_chrome_version": "120",
    "permissions": [
        "cookies",
        "storage",
        "alarms",
        "notifications"
    ],
    "host_permissions": [
        "https://*.bilibili.com/*",
        "https://*.hdslb.com/*"
    ],
    "action": {
        "default_popup": "popup/popup.html",
        "default_icon": {
            "16": "images/icon16.png",
            "32": "images/icon32.png",
            "48": "images/icon48.png",
            "128": "images/icon128.png"
        }
    },
    "content_scripts": [
        {
            "matches": [
                "*://www.bilibili.com/blackboard/live/live-activity-player.html*"
            ],
            "js": [
                "content_script.js"
            ],
            "all_frames": true,
            "run_at": "document_end"
        }
    ],
    "background": {
        "service_worker": "background/index.js",
        "type": "module"
    },
    "icons": {
        "16": "images/icon16.png",
        "32": "images/icon32.png",
        "48": "images/icon48.png",
        "128": "images/icon128.png"
    }
}
