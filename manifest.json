{
    "manifest_version": 3,
    "default_locale": "en",
    "name": "BiliStreamMonitor",
    "version": "4.0",
    "description": "Live status for your Bilibili medal wall, custom rooms, marked streamers, or everyone you follow.",
    "minimum_chrome_version": "120",
    "permissions": [
        "cookies",
        "storage",
        "alarms",
        "notifications"
    ],
    "host_permissions": [
        "https://*.bilibili.com/*",
        "https://*.hdslb.com/*"
    ],
    "action": {
        "default_popup": "popup/popup.html",
        "default_icon": {
            "16": "images/icon16.png",
            "32": "images/icon32.png",
            "48": "images/icon48.png",
            "128": "images/icon128.png"
        }
    },
    "background": {
        "service_worker": "background/index.js",
        "type": "module"
    },
    "icons": {
        "16": "images/icon16.png",
        "32": "images/icon32.png",
        "48": "images/icon48.png",
        "128": "images/icon128.png"
    }
}
