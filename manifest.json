{
    "manifest_version": 3,
    "default_locale": "en",
    "name": "BiliStreamMonitor",
    "version": "3.2",
    "description": "Monitor Bilibili live status of your followed streamers (full-following or medal wall mode).",
    "permissions": [
        "cookies",
        "storage",
        "tabs",
        "alarms",
        "notifications"
    ],
    "host_permissions": [
        "https://*.bilibili.com/*",
        "https://*.hdslb.com/*"
    ],
    "action": {
        "default_popup": "popup/popup.html",
        "default_icon": {
            "128": "images/icon128.png"
        }
    },
    "content_scripts": [
        {
            "matches": ["*://www.bilibili.com/blackboard/live/live-activity-player.html*"],
            "js": ["content_script.js"],
            "all_frames": true,
            "run_at": "document_end"
        }
    ],
    "background": {
        "service_worker": "background/index.js",
        "type": "module"
    },
    "icons": {
        "128": "images/icon128.png"
    }
}